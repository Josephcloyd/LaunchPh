# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: address of the separate resume builder (https://...). Leave empty to hide links to it.
NEXT_PUBLIC_RESUME_BUILDER_URL=

# Supabase — use the project URL and publishable/anon key only in browser variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot check on the public inquiry forms).
# Local development: Cloudflare's always-pass test keys below. Production: your widget's real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Manual payments: the accounts customers pay into. A method shows at checkout only when its
# name and number are set. QR codes are optional images in /public, e.g. /payments/gcash-qr.png.
PAYMENT_GCASH_NAME=
PAYMENT_GCASH_NUMBER=
PAYMENT_GCASH_QR_URL=
PAYMENT_MAYA_NAME=
PAYMENT_MAYA_NUMBER=
PAYMENT_MAYA_QR_URL=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_QR_URL=

# Email (payment confirmations, expiry reminders, admin alerts). Gmail works to start:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<Google app password>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Shared secret for the daily expiry reminder job (/api/cron/expiry-reminders).
CRON_SECRET=

# Payment provider adapter (configure one provider in production)
PAYMENT_PROVIDER=development
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional email and monitoring adapters
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
