# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESUME_BUILDER_URL=https://resume.launchph.ph

# Supabase — use the project URL and publishable/anon key only in browser variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot check on the public inquiry forms).
# Local development: Cloudflare's always-pass test keys below. Production: your widget's real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Payment provider adapter (configure one provider in production)
PAYMENT_PROVIDER=development
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional email and monitoring adapters
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
